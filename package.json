{
  "name": "nxt-studio",
  "productName": "NXT Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Block-based programming and live gamepad control for LEGO MINDSTORMS NXT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "electron": "45.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "blockly": "13.4.0"
  }
}
